# ----------------------------------------------------------------
# DataVision AI — example environment configuration
# Copy this file to ".env" and adjust the values. Never commit .env.
# ----------------------------------------------------------------

# Port the server listens on
PORT=3000

# Secret used to sign login tokens (JWT). Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Seeded administrator account (created on first start if missing).
# Change these before any real deployment!
ADMIN_EMAIL=admin@datavision.local
ADMIN_PASSWORD=Admin@1234

# ---------- OPTIONAL: AI-phrased insights ----------
# If set, the Insights page sends VERIFIED computed statistics (never raw
# data files) to an OpenAI-compatible API from the server, and labels the
# output "AI-generated". If left empty, a transparent rule-based engine is
# used instead and clearly labelled as such.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# For OpenAI-compatible providers, override the base URL:
OPENAI_BASE_URL=https://api.openai.com/v1
